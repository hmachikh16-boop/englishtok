# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# English lesson TTS is bundled with the app; no API key or server setup is needed.

# AI tutor (server-only). Never add a VITE_ prefix to these values.
# With no key, /api/chat answers instantly through the built-in local tutor.
# Add a key for generative replies; if the provider fails or is slow, the API
# automatically falls back to the local tutor instead of showing an error.
# Free option: Cloudflare Workers AI. Use a fast instruct model for snappy
# tutor replies; reasoning models add several seconds before the first token.
# Create an API token with Workers AI permission, then set the account ID and token.
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Anonymous Pollinations fallback is opt-in only. It is frequently rate-limited
# and can take 20+ seconds; leave this false unless you explicitly want to try it.
AI_FREE_FALLBACK=false
POLLINATIONS_MODEL=openai-fast

# Optional paid option: the official DeepSeek API (OpenAI-compatible).
# Set AI_PROVIDER=deepseek to use it instead of Cloudflare.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: OpenRouter can be used with a DeepSeek model that you choose.
# Set AI_PROVIDER=openrouter to use it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional web/API origin override. Leave empty for the web build (same origin).
# The Android app defaults to https://englishtok-eight.vercel.app because
# Capacitor serves its web assets from https://localhost. Set this only when
# deploying the API on a different domain.
VITE_API_BASE_URL=

# Public GitHub repository used for release checks and published lesson-content updates.
# Set this to owner/repository for Vercel builds; GitHub Actions injects it automatically.
VITE_GITHUB_REPOSITORY=

# Optional cross-device progress backup (Upstash Redis REST / Vercel KV).
# Keep these server-only; never add a VITE_ prefix or expose them to the browser.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Online Gold Control admin dashboard (/control). Keep this server-only.
# Generate a long random value and set it as a Vercel Secret in Production
# and Preview. LINGO_ADMIN_STORE_KEY is optional and useful for staging.
LINGO_ADMIN_KEY=
LINGO_ADMIN_STORE_KEY=

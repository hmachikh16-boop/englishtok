{
  "name": "english-tok",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "content:export": "tsx scripts/export-learning-path.ts",
    "content:ipa": "tsx scripts/build-pronunciations.ts",
    "content:validate": "tsx scripts/validate-curriculum.ts",
    "speech:check": "tsx scripts/check-speech-library.ts",
    "speech:audit": "tsx scripts/check-speech-library.ts --allow-missing",
    "speech:generate": "tsx scripts/generate-speech-library.ts",
    "generate:lesson-illustrations": "tsx scripts/generate-lesson-illustrations.ts",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "build": "npm run content:export && npm run speech:check && npm run generate:lesson-illustrations && node scripts/stage-latest-apk.mjs && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "node scripts/build-android-apk.mjs",
    "android:apk:store": "node scripts/build-android-store-apk.mjs",
    "android:aab": "node scripts/build-android-aab.mjs",
    "serve:releases": "node scripts/serve-releases.mjs",
    "android:open": "cap open android",
    "preview": "vite preview",
    "preview:phone": "npm run build && node scripts/preview-phone.mjs",
    "start": "tsx server.ts --production",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "generate:speech": "tsx scripts/generate-speech-library.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "ipa-dict": "^1.0.3",
    "kokoro-js": "^1.2.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
